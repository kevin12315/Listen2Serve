# Copy to .env in the repository root. Fill keys locally; .env is gitignored.

# Customer simulator: the paper model, served by Moonshot.
MOONSHOT_API_KEY=
#MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k3
#SIM_MODEL=kimi-k3

# Qwen agents, customer TTS, and uniform ASR.
DASHSCOPE_API_KEY=
#TTS_MODEL=qwen-audio-3.0-tts-plus
#ASR_MODEL=qwen-audio-3.0-asr-flash
#DASHSCOPE_TTS_URL=https://dashscope.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# Action, voice, flow and task judges.
GEMINI_API_KEY=
JUDGE_MODEL=google/gemini-3.8-flash
VOICE_JUDGE_MODEL=google/gemini-3.8-flash

# Doubao speech-service credential (only needed for the Doubao agent).
VOLC_API_KEY=
#VOLC_API_KEY2=

# Optional alternative OpenAI-compatible simulator or judge.
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=
#SIM_MODEL=openai/your-model-id

# Optional voice overrides; normally use the shipped assignments.
#TTS_VOICE_USER=
#REALTIME_VOICE=
