# Listen2Serve config template: `cp .env.example .env` then fill in (.env is gitignored).

# ---- Agent-under-test / TTS / ASR: DashScope (Model Studio / Bailian) ----
DASHSCOPE_API_KEY=

# ---- Text LLM: default model used by the constrained user simulator (public Bailian name) ----
LLM_MODEL=qwen-plus
# ---- Judge: by default go through Google's official OpenAI-compatible endpoint for Gemini
#      (same model the paper used). All three judgements (key-turn action / output voice /
#      flow & task) use this single key.
GEMINI_API_KEY=
#JUDGE_MODEL=google/gemini-3.8-flash
#VOICE_JUDGE_MODEL=google/gemini-3.8-flash
# Judge and generator are deliberately separate sources: the same model both writing customer
# lines and scoring the agent would introduce a shared-style bias.
# Leaving JUDGE_MODEL unset = follow LLM_MODEL.
# User-simulator model; unset = follow LLM_MODEL.
#SIM_MODEL=qwen-plus

# ---- Generic OpenAI-compatible backend (swap judge / simulator through it, any vendor) ----
# Once set, you can write `openai/<model-name>` without registering it in this repo's binding table:
#   self-hosted vLLM   OPENAI_BASE_URL=http://localhost:8000/v1   OPENAI_API_KEY=dummy
#   Gemini compat      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                      JUDGE_MODEL=openai/gemini-2.5-flash  VOICE_JUDGE_MODEL=openai/gemini-2.5-flash
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=

# ---- ASR / TTS (Bailian) ----
#ASR_MODEL=qwen-audio-3.0-asr-flash
#TTS_MODEL=qwen-audio-3.0-tts-plus

# ---- Voice override (defaults come from the binding table in src/listen2serve/model_registry.py;
#      use these only for quick experiments, then write the chosen voice back into the table) ----
#TTS_VOICE_USER=
#REALTIME_VOICE=

# ---- Cross-vendor agent-under-test (Doubao full-duplex; only needed when evaluating doubao-*) ----
#VOLC_API_KEY=
#VOLC_API_KEY2=

# ---- Other switches ----
#TOOLS_ENABLED=false
#AGENT_PROMPT=v9
